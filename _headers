# Response headers for Cloudflare Pages.
#
# Response headers, sent from a file so the policy comes back without the app
# growing a server to send it (CONTEXT.md).
#
# This lives in the project root, not static/ — adapter-cloudflare reads it
# from there and appends its own asset-caching rules before writing it into the
# build. A copy in static/ is warned about and ignored.

/*
  # The rest of the policy is generated by SvelteKit and emitted as a <meta>
  # tag, because it needs the hash of the framework's own inline bootstrap
  # script — see svelte.config.js. `frame-ancestors` is ignored in a meta tag,
  # so it has to be a real header, and this is it. Two policies both apply and
  # are intersected, and a policy naming only frame-ancestors constrains
  # nothing else.
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

  # Do not leak this app's URL to every PDS the browser contacts. Someone's
  # list of accounts to unfollow is not a referrer's business.
  Referrer-Policy: no-referrer

  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

/oauth-client-metadata.json
  # Authorization servers fetch this to learn what the app is allowed to ask
  # for. `prerender` writes the body to a file and drops the response headers
  # the route sets, so they are restated here.
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
